@using WebApplication1.Data.Models
@model Items

@{
    Layout = "_Layout";
    IEnumerable<Categorys> Categories = ViewBag.Categories;
}

<h2>Редактирование предмета</h2>

<form method="post" enctype="multipart/form-data" action="/Items/Update">
    <input type="hidden" name="id" value="@Model.Id" />
    
    <div>
        <label>Наименование:</label>
        <br />
        <input type="text" name="name" value="@Model.Name" required />
    </div>
    
    <div>
        <label>Описание:</label>
        <br />
        <textarea name="description" rows="5">@Model.Description</textarea>
    </div>
    
    <div>
        <label>Текущее изображение:</label>
        <br />
        <img src="@Model.img" width="100" height="100" style="object-fit:cover;" />
        <br />
        <label>Новое изображение (оставьте пустым, чтобы не менять):</label>
        <br />
        <input type="file" name="files" />
    </div>
    
    <div>
        <label>Стоимость:</label>
        <br />
        <input type="number" name="price" value="@Model.Price" required />
    </div>
    
    <div>
        <label>Категория:</label>
        <br />
        <select name="idCategory">
            @foreach (var cat in Categories)
            {
                if (cat.Id == Model.category.Id)
                {
                    <option value="@cat.Id" selected>@cat.Name</option>
                }
                else
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            }
        </select>
    </div>
    
    <br />
    <input type="submit" value="Сохранить изменения" style="background: #4CAF50; color: white; padding: 10px 20px; border: none; cursor: pointer;" />
    <a href="/Items/List" style="background: #f44336; color: white; padding: 10px 20px; text-decoration: none;">Отмена</a>
</form>

<style>
    form div {
        margin-bottom: 15px;
    }
    
    form input[type="text"],
    form input[type="number"],
    form textarea,
    form select {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
    
    form textarea {
        resize: vertical;
    }
</style>